# ─── Banco de dados ───────────────────────────────────────────────────────────
# URL de conexão PostgreSQL (Supabase). Deixe vazio para usar SQLite local.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Clerk (autenticação) ─────────────────────────────────────────────────────
CLERK_JWKS_URL=https://<your-clerk-frontend-api>/.well-known/jwks.json
CLERK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx

# ─── Supabase Storage ─────────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
LAUDO_BUCKET=laudos

# ─── Notificações ─────────────────────────────────────────────────────────────
# Resend (email)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM=noreply@moveacre.com.br

# Twilio (WhatsApp) — opcional
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Z-API (WhatsApp alternativo) — opcional
ZAPI_INSTANCE_ID=xxxxxxxxxxxxxxxxxxxx
ZAPI_TOKEN=xxxxxxxxxxxxxxxxxxxx

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://moveacre.com.br,https://www.moveacre.com.br

# ─── Admin ────────────────────────────────────────────────────────────────────
ADMIN_EMAILS=admin@moveacre.com.br

# ─── Rate limiting (opcional) ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Dev ──────────────────────────────────────────────────────────────────────
BASE_URL=http://localhost:5000
